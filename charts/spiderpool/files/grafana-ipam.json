          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(spiderpool_iaas_allocation_total{cluster=~\"$cluster\",path=\"cache_hit\"}[$__rate_interval])) / sum(rate(spiderpool_iaas_allocation_total{cluster=~\"$cluster\"}[$__rate_interval]))",
          "refId": "A"
        }
      ]
    },
